# vim:ft=kitty

## name: Monokai Pro Light
## upstream: https://monokai.pro


# The basic colors
foreground #29242a
background #faf4f2
selection_foreground #faf4f2
selection_background #29242a

# Cursor colors
cursor #706b6e
cursor_text_color #a39ea1

# Scrollbar colors
scrollbar_handle_color #a59fa0
scrollbar_track_color #d3cdcc

# URL color when hovering with mouse
url_color #1c8ca8

# Kitty window border colors
active_border_color #1c8ca8
inactive_border_color #d3cdcc
bell_border_color #cc7a0a

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system
macos_show_window_title_in none

# Tab bar colors
active_tab_foreground #faf4f2
active_tab_background #7058be
inactive_tab_foreground #29242a
inactive_tab_background #ede7e5
tab_bar_background #d3cdcc

# Colors for marks (marked text in the terminal)
mark1_foreground #faf4f2
mark1_background #1c8ca8
mark2_foreground #faf4f2
mark2_background #7058be
mark3_foreground #faf4f2
mark3_background #cc7a0a

# The 16 terminal colors

# black
color0 #d3cdcc
color8 #a59fa0

# red
color1 #e14775
color9 #e14775

# green
color2 #269d69
color10 #269d69

# yellow
color3 #cc7a0a
color11 #cc7a0a

# blue
color4 #e16032
color12 #e16032

# magenta
color5 #7058be
color13 #7058be

# cyan
color6 #1c8ca8
color14 #1c8ca8

# white
color7 #706b6e
color15 #29242a
