# vim:ft=kitty

## name: Everforest Dark
## upstream: https://github.com/sainnhe/everforest


# The basic colors
foreground #d3c6aa
background #2d353b
selection_foreground #9da9a0
selection_background #505a60

# Cursor colors
cursor #d3c6aa
cursor_text_color #343f44

# Scrollbar colors
scrollbar_handle_color #7a8478
scrollbar_track_color #343f44

# URL color when hovering with mouse
url_color #7fbbb3

# Kitty window border colors
active_border_color #a7c080
inactive_border_color #56635f
bell_border_color #e69875

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system
macos_show_window_title_in none

# Tab bar colors
active_tab_foreground #d3c6aa
active_tab_background #2d353b
inactive_tab_foreground #9da9a0
inactive_tab_background #3d484d
tab_bar_background #343f44

# Colors for marks (marked text in the terminal)
mark1_foreground #2d353b
mark1_background #7fbbb3
mark2_foreground #2d353b
mark2_background #d3c6aa
mark3_foreground #2d353b
mark3_background #d699b6

# The 16 terminal colors

# black
color0 #343f44
color8 #56635f

# red
color1 #e67e80
color9 #e67e80

# green
color2 #a7c080
color10 #a7c080

# yellow
color3 #dbbc7f
color11 #e69875

# blue
color4 #7fbbb3
color12 #7fbbb3

# magenta
color5 #d699b6
color13 #d699b6

# cyan
color6 #83c092
color14 #83c092

# white
color7 #859289
color15 #9da9a0
