# vim:ft=kitty

## name: Nord
## upstream: https://github.com/nordtheme/xresources/blob/develop/src/nord


# The basic colors
foreground #d8dee9
background #2e3440
selection_foreground #d8dee9
selection_background #4c566a

# Cursor colors
cursor #d8dee9
cursor_text_color #2e3440

# Scrollbar colors
scrollbar_handle_color #4c566a
scrollbar_track_color #3b4252

# URL color when hovering with mouse
url_color #88c0d0

# Kitty window border colors
active_border_color #81a1c1
inactive_border_color #4c566a
bell_border_color #88c0d0

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system
macos_show_window_title_in none

# Tab bar colors
active_tab_foreground #3b4252
active_tab_background #88c0d0
inactive_tab_foreground #e5e9f0
inactive_tab_background #4c566a
tab_bar_background #3b4252

# Colors for marks (marked text in the terminal)
mark1_foreground #3b4252
mark1_background #88c0d0
mark2_foreground #3b4252
mark2_background #bf616a
mark3_foreground #3b4252
mark3_background #ebcb8b

# The 16 terminal colors

# black
color0 #3b4252
color8 #4c566a

# red
color1 #bf616a
color9 #d08770

# green
color2 #a3be8c
color10 #a3be8c

# yellow
color3 #ebcb8b
color11 #ebcb8b

# blue
color4 #81a1c1
color12 #5e81ac

# magenta
color5 #b48ead
color13 #b48ead

# cyan
color6 #88c0d0
color14 #8fbcbb

# white
color7 #e5e9f0
color15 #eceff4
