# vim:ft=kitty

## name: Solarized Dark
## upstream: https://github.com/altercation/solarized


# The basic colors
foreground #839496
background #002b36
selection_foreground #93a1a1
selection_background #073642

# Cursor colors
cursor #93a1a1
cursor_text_color #002b36

# Scrollbar colors
scrollbar_handle_color #586e75
scrollbar_track_color #073642

# URL color when hovering with mouse
url_color #2aa198

# Kitty window border colors
active_border_color #268bd2
inactive_border_color #073642
bell_border_color #b58900

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system
macos_show_window_title_in none

# Tab bar colors
active_tab_foreground #002b36
active_tab_background #268bd2
inactive_tab_foreground #839496
inactive_tab_background #073642
tab_bar_background #002b36

# Colors for marks (marked text in the terminal)
mark1_foreground #002b36
mark1_background #268bd2
mark2_foreground #002b36
mark2_background #6c71c4
mark3_foreground #002b36
mark3_background #2aa198

# The 16 terminal colors

# black
color0 #073642
color8 #586e75

# red
color1 #dc322f
color9 #cb4b16

# green
color2 #859900
color10 #859900

# yellow
color3 #b58900
color11 #b58900

# blue
color4 #268bd2
color12 #268bd2

# magenta
color5 #d33682
color13 #6c71c4

# cyan
color6 #2aa198
color14 #2aa198

# white
color7 #93a1a1
color15 #fdf6e3
