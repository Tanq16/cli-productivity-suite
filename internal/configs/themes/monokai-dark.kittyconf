# vim:ft=kitty

## name: Monokai Pro
## upstream: https://monokai.pro


# The basic colors
foreground #fcfcfa
background #2d2a2e
selection_foreground #2d2a2e
selection_background #fcfcfa

# Cursor colors
cursor #c1c0c0
cursor_text_color #8e8d8d

# Scrollbar colors
scrollbar_handle_color #727072
scrollbar_track_color #403e41

# URL color when hovering with mouse
url_color #78dce8

# Kitty window border colors
active_border_color #78dce8
inactive_border_color #403e41
bell_border_color #ffd866

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system
macos_show_window_title_in none

# Tab bar colors
active_tab_foreground #19181a
active_tab_background #ab9df2
inactive_tab_foreground #fcfcfa
inactive_tab_background #221f22
tab_bar_background #19181a

# Colors for marks (marked text in the terminal)
mark1_foreground #221f22
mark1_background #78dce8
mark2_foreground #221f22
mark2_background #ab9df2
mark3_foreground #221f22
mark3_background #ffd866

# The 16 terminal colors

# black
color0 #403e41
color8 #727072

# red
color1 #ff6188
color9 #ff6188

# green
color2 #a9dc76
color10 #a9dc76

# yellow
color3 #ffd866
color11 #ffd866

# blue
color4 #fc9867
color12 #fc9867

# magenta
color5 #ab9df2
color13 #ab9df2

# cyan
color6 #78dce8
color14 #78dce8

# white
color7 #c1c0c0
color15 #fcfcfa
